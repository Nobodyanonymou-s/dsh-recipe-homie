{
  "name": "dsh-recipe-homie",
  "version": "0.7.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "DSH 里的中国菜谱插件：正派菜谱检索、按人排菜单、采购清单、随机挑战 / Chinese-cooking plugin for DSH",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./query": "./lib/query.js",
    "./parse": "./lib/parse.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "data-sample",
    "presets.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm smoke && pnpm test:contract",
    "prepare": "tsdown",
    "prepack": "tsdown",
    "data:build": "node src/build.mjs",
    "data:integrate": "node src/integrate.mjs",
    "data:build:all": "node src/build.mjs 上海 北京 江苏 浙江 广东 安徽 山东 湖北 湖南 陕西",
    "smoke": "node tools/smoke.mjs",
    "test:client": "node tools/test-client.mjs",
    "test:contract": "node tools/contract-test.mjs",
    "test:amounts": "node tools/amounts-test.mjs",
    "test:acceptance": "node tools/acceptance.mjs",
    "nutrition": "node tools/nutrition-check.mjs",
    "audit": "node tools/audit.mjs",
    "pools": "node tools/pools-audit.mjs",
    "pool": "node tools/pool-report.mjs",
    "replay": "node tools/replay-0.4.mjs",
    "demo": "node tools/plan-demo.mjs 3 4",
    "inspect": "node tools/inspect.mjs",
    "lexicon": "node tools/lexicon-report.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nobodyanonymou-s/dsh-recipe-homie.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "recipe",
    "cooking",
    "chinese-cuisine",
    "meal-planning"
  ]
}
