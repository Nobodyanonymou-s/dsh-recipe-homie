{
  "name": "dsh-foodbot",
  "version": "0.5.8",
  "license": "Apache-2.0",
  "type": "module",
  "description": "把《中国菜谱》各省分册变成 DSH 里的菜谱检索工具：按食材/菜系/技法找菜，取原始斤两配比与出处页码",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./client": "./client/client.js",
    "./query": "./src/query.mjs",
    "./parse": "./src/parse.mjs"
  },
  "files": [
    "src",
    "client",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "integrate": "node src/integrate.mjs",
    "build:all": "node src/build.mjs 上海 北京 江苏 浙江 广东 安徽 山东 湖北 湖南 陕西",
    "smoke": "node tools/smoke.mjs",
    "test:client": "node tools/test-client.mjs",
    "test:contract": "node tools/contract-test.mjs",
    "test:amounts": "node tools/amounts-test.mjs",
    "test:acceptance": "node tools/acceptance.mjs",
    "nutrition": "node tools/nutrition-check.mjs",
    "audit": "node tools/audit.mjs",
    "pools": "node tools/pools-audit.mjs",
    "pool": "node tools/pool-report.mjs",
    "replay": "node tools/replay-0.4.mjs",
    "demo": "node tools/plan-demo.mjs 3 4",
    "inspect": "node tools/inspect.mjs",
    "lexicon": "node tools/lexicon-report.mjs"
  }
}
